$! env.com.example - copy to tools/env-<node>.com (git-ignored) and adjust
$ define/nolog/process VU_CURL_OLB DISK$USER:[USERNAME.VMS_GREP.CURL-8_22_0.PROJECTS.VMS.<ARCH>]CURLLIB.OLB
$ define/nolog/process VU_CURL_INCLUDE DISK$USER:[USERNAME.VMS_GREP.CURL-8_22_0.INCLUDE.CURL]
$ define/nolog/process/translation_attributes=concealed ZLIB$ROOT DISK$USER:[USERNAME.VMS_GREP.ZLIB-1_3_2.INSTALL_<ARCH>.]
$ define/nolog/process/translation_attributes=concealed ZSTD$ROOT DISK$USER:[USERNAME.VMS_GREP.ZSTD-1_5_7.INSTALL_<ARCH>.]
$! When the work directory is under a rooted logical (USER$ROOT:), resolve it first:
$!   d = "USER$ROOT:[USERNAME.VMS_GREP.ZLIB-1_3_2.INSTALL_<ARCH>]"
$!   r = f$parse(d,,,"DEVICE","NO_CONCEAL") + (f$parse(d,,,"DIRECTORY","NO_CONCEAL") - "][" - "]") + ".]"
$!   define/nolog/process/translation_attributes=concealed ZLIB$ROOT 'r'
