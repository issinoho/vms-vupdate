! vupdate.cld - DCL verb VUPDATE.
!   VUPDATE LOGIN [/USERNAME=e-mail]
!   VUPDATE LOGOUT
!   VUPDATE CHECK [/SECURITY] [/FIELD_TEST] [/ALL] [/REFRESH] [/OUTPUT=file]
!   VUPDATE SHOW product [/FIELD_TEST] [/REFRESH]
!   VUPDATE UPGRADE [product[,...]] [/ALL] [/PATCHES] [/UPDATES] [/SECURITY]
!                   [/NOREBOOT] [/NOCONFIRM] [/DISCARD_RECOVERY_DATA]
!                   [/FIELD_TEST] [/DOWNLOAD_ONLY]
!                   [/WORK=directory] [/REFRESH]
!   VUPDATE HELP [topic...]
!   VUPDATE VERSION

define type ACTIONS
    keyword LOGIN,   syntax=VU_LOGIN
    keyword LOGOUT,  syntax=VU_LOGOUT
    keyword CHECK,   syntax=VU_CHECK
    keyword SHOW,    syntax=VU_SHOW
    keyword UPGRADE, syntax=VU_UPGRADE
    keyword HELP,    syntax=VU_HELP
    keyword VERSION, syntax=VU_VERSION

define verb VUPDATE
    image VUPDATE$ROOT:[SYSEXE]VUPDATE.EXE
    parameter P1, label=ACTION, prompt="Action", value(required, type=ACTIONS)

define syntax VU_LOGIN
    parameter P1, label=ACTION, value(required, type=ACTIONS)
    qualifier USERNAME, value(required)

define syntax VU_LOGOUT
    parameter P1, label=ACTION, value(required, type=ACTIONS)

define syntax VU_CHECK
    parameter P1, label=ACTION, value(required, type=ACTIONS)
    qualifier SECURITY
    qualifier FIELD_TEST
    qualifier ALL
    qualifier REFRESH
    qualifier OUTPUT, value(required, type=$FILE)

define syntax VU_SHOW
    parameter P1, label=ACTION, value(required, type=ACTIONS)
    parameter P2, label=PRODUCT, prompt="Product", value(required)
    qualifier FIELD_TEST
    qualifier REFRESH

define syntax VU_UPGRADE
    parameter P1, label=ACTION, value(required, type=ACTIONS)
    parameter P2, label=PRODUCT, prompt="Product", value(list)
    qualifier ALL
    qualifier SECURITY
    qualifier PATCHES
    qualifier UPDATES
    qualifier REBOOT, default
    qualifier DISCARD_RECOVERY_DATA
    qualifier CONFIRM, default
    qualifier FIELD_TEST
    qualifier DOWNLOAD_ONLY
    qualifier WORK, value(required, type=$FILE)
    qualifier REFRESH
    disallow not (PRODUCT or ALL or SECURITY or PATCHES or UPDATES)
    disallow PRODUCT and ALL

define syntax VU_HELP
    parameter P1, label=ACTION, value(required, type=ACTIONS)
    parameter P2, label=TOPIC, value(type=$REST_OF_LINE)

define syntax VU_VERSION
    parameter P1, label=ACTION, value(required, type=ACTIONS)
